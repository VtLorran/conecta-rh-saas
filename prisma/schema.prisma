generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Perfis de acesso no sistema (tanto para quem já trabalha quanto para os novos)
enum UserRole {
  ADMIN
  USER
}

// Estados do processo de admissão
enum AdmissionStatus {
  INVITED // Link enviado por e-mail, aguardando preenchimento do colaborador
  SUBMITTED // Colaborador preencheu e enviou de volta (opcional, se houver etapa intermediária)
  UNDER_REVIEW // Colaborador enviou e o RH está analisando os dados/documentos
  ACTIVE // Aprovado / Contratado definitivamente (Gera um User ativo)
  REJECTED // Recusado pelo RH
}

// Status do contrato de trabalhado do colaborador ativo
enum EmployeeStatus {
  ACTIVE // ativo 
  INACTIVE // inativo 
  SUSPENDED // suspenso
  VACATION // de férias 
}

// 1. USUÁRIOS (Quem efetivamente faz login no sistema)
model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  cpf           String         @unique
  password      String? // Opcional no início, até que o usuário crie a senha no primeiro acesso
  role          UserRole       @default(USER)
  avatar        String? // URL da foto do usuário
  status        EmployeeStatus @default(ACTIVE) // ativo, inativo, de férias, suspenso
  jobPositionId String? // cargo atual do colaborador
  jobPosition   JobPosition?   @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)

  // Relacionamentos:
  templates          AdmissionTemplate[]
  admissions         Admission[]
  vacations          Vacation[]          @relation("UserVacations")
  approvedVacations  Vacation[]          @relation("ApprovedVacations")
  dayOffs            DayOff[]            @relation("UserDayOffs")
  approvedDayOffs    DayOff[]            @relation("ApprovedDayOffs")
  workSchedules      WorkSchedule[]      @relation("UserWorkSchedules")
  timeRecords        TimeRecord[]
  documentRequests   DocumentRequest[]
  notifications      Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// 2. TEMPLATES DE ADMISSÃO (Os padrões que o RH salva para não repetir trabalho)
model AdmissionTemplate {
  id             String      @id @default(uuid())
  name           String // Ex: "Padrão Desenvolvedor CLT", "Estágio Administrativo"
  description    String?
  requiredFields Json // Quais campos/documentos serão exigidos (ex: ["rg", "comprovante_residencia", "diploma"])
  createdById    String
  createdBy      User        @relation(fields: [createdById], references: [id])
  admissions     Admission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admission_templates")
}

// 3. PROCESSO DE ADMISSÃO (O fluxo de contratação de um novo colaborador)
model Admission {
  id                String          @id @default(uuid())
  candidateName     String
  candidateEmail    String
  candidateCpf      String
  candidatePassword String?
  candidateAvatar   String? // URL da foto que o colaborador vai enviar, exibida na listagem
  status            AdmissionStatus @default(INVITED)
  justification     String? // Justificativa de correção ou cancelamento enviada pelo RH
  candidateRole     UserRole        @default(USER)

  jobPositionId String
  jobPosition   JobPosition @relation(fields: [jobPositionId], references: [id])

  formConfig  Json // Configuração dos campos exigidos (copiado do template ou customizado no modal)
  formData    Json? // Dados e documentos que o candidato preencheu e enviou de volta
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id])
  templateId  String?
  template    AdmissionTemplate? @relation(fields: [templateId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidateCpf, status])
  @@index([status])
  @@index([updatedAt])
  @@index([status, updatedAt(sort: Desc)])
  @@map("admissions")
}

// 4. SETORES DA EMPRESA
model Department {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  positions   JobPosition[] // um setor possui vários cargos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

// 5. CARGOS DA EMPRESA VINCULADOS AOS SETORES
model JobPosition {
  id           String      @id @default(uuid())
  name         String
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users        User[]
  admissions   Admission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, departmentId])
  @@map("job_positions")
}

// 6. FÉRIAS DOS COLABORADORES
enum VacationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Vacation {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  user         User           @relation("UserVacations", fields: [userId], references: [id], onDelete: Cascade)
  startDate    DateTime       @map("start_date")
  endDate      DateTime       @map("end_date")
  status       VacationStatus @default(PENDING)
  approvedById String?        @map("approved_by_id")
  approvedBy   User?          @relation("ApprovedVacations", fields: [approvedById], references: [id], onDelete: SetNull)
  comment      String? // Opcional (motivo, observações, etc.)
  
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("vacations")
}

// 6.2 FOLGAS DOS COLABORADORES
enum DayOffStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model DayOff {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  user         User         @relation("UserDayOffs", fields: [userId], references: [id], onDelete: Cascade)
  startDate    DateTime     @map("start_date")
  endDate      DateTime     @map("end_date")
  status       DayOffStatus @default(PENDING)
  approvedById String?      @map("approved_by_id")
  approvedBy   User?        @relation("ApprovedDayOffs", fields: [approvedById], references: [id], onDelete: SetNull)
  comment      String? // Opcional (motivo, observações, justificativa, etc.)
  
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("day_offs")
}

// 7. ESCALA/CALENDÁRIO DE TRABALHO DO COLABORADOR
model WorkSchedule {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation("UserWorkSchedules", fields: [userId], references: [id], onDelete: Cascade)
  type         String    @default("FIXED") // "FIXED" ou "SPECIFIC"
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  description  String?
  scheduleData Json      // Armazena a escala de dias e horas
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("work_schedules")
}

// 8. CATEGORIAS DE PAUSAS DO PONTO
model PauseCategory {
  id        String            @id @default(uuid())
  name      String            @unique // Ex: "Almoço", "Lanche"
  duration  Int               // Duração recomendada em minutos (ex: 60)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  pauses    TimeRecordPause[]

  @@map("pause_categories")
}

// 9. REGISTROS DE PONTO (DIÁRIO)
model TimeRecord {
  id        String            @id @default(uuid())
  userId    String            @map("user_id")
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime          // O dia do ponto (ex: 2026-06-14)
  entryTime DateTime?         @map("entry_time") // Ponto de Entrada padrão
  exitTime  DateTime?         @map("exit_time")  // Ponto de Saída padrão
  pauses    TimeRecordPause[]
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@map("time_records")
}

// 10. PAUSAS REALIZADAS NO PONTO
model TimeRecordPause {
  id              String        @id @default(uuid())
  timeRecordId    String        @map("time_record_id")
  timeRecord      TimeRecord    @relation(fields: [timeRecordId], references: [id], onDelete: Cascade)
  pauseCategoryId String        @map("pause_category_id")
  pauseCategory   PauseCategory @relation(fields: [pauseCategoryId], references: [id], onDelete: Restrict)
  startTime       DateTime      @map("start_time")
  endTime         DateTime?     @map("end_time")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@map("time_record_pauses")
}

// 11. REQUISIÇÕES DE DOCUMENTOS (ONBOARDING)
model DocumentRequest {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements Json     // Array of: { name: string, type: "file" | "text" }
  answers      Json?    // Array of: { name: string, type: "file" | "text", value?: string }
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("document_requests")
}

// 12. PASTAS DE DOCUMENTOS GERAIS
model Folder {
  id        String     @id @default(uuid())
  name      String     @unique
  documents Document[]

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("folders")
}

// 13. DOCUMENTOS GERAIS
model Document {
  id        String   @id @default(uuid())
  name      String
  value     String   // Base64 file contents
  folderId  String   @map("folder_id")
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("documents")
}

// 14. DADOS DA EMPRESA (Persistidos no Banco)
model CompanyData {
  id                 String   @id @default(uuid())
  razaoSocial        String
  nomeFantasia       String
  cnpj               String   @unique
  emailCorporativo   String?
  telefone           String?
  cep                String?
  cidade             String?
  estado             String?
  pais               String?
  responsavelNome    String?
  responsavelEmail   String?
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  site               String?
  whatsapp           String?
  dataFundacao       String?
  porte              String?
  segmento           String?
  instagram          String?
  linkedin           String?
  primaryColor       String?
  logoPreview        String?  // Armazena a imagem em formato base64/URL

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("company_data")
}

// 15. NOTIFICAÇÕES DO SISTEMA
model Notification {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  read        Boolean  @default(false)
  link        String?  // Opcional: link para redirecionamento
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

// 16. DEMISSÕES (Registro leve / log append-only de colaboradores demitidos)
// Sem relations e sem blobs de propósito: apenas snapshots em texto para não pesar no banco.
model Termination {
  id              String   @id @default(uuid())
  employeeName    String   @map("employee_name") // snapshot do nome completo
  sector          String                        // snapshot do setor onde estava
  justification   String                        // motivo da demissão
  dismissedByName String?  @map("dismissed_by_name") // snapshot de quem demitiu (host)
  terminatedAt    DateTime @default(now()) @map("terminated_at")

  @@index([terminatedAt])
  @@map("terminations")
}
